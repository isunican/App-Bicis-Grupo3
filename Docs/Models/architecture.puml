' ==========================================

DetailsView ..> StationsView : <<use>>
StationsView ..|> IStationsContract.View
StationsPresenter ..|> IStationsContract.Presenter
StationsView --> IStationsContract.Presenter : presenter
StationsPresenter --> IStationsContract.View : view
StationsView --> INetworksRepository : repository
StationsView ..> StationsArrayAdapter : <<use>>
StationsView ..> DetailsView : <<use>>
StationsPresenter ..> StationFilter : <<use>>
StationsPresenter ..> StationUtils : <<use>>
StationsPresenter ..> StationSearch : <<use>>
INetworksRepository ..> StationsCallback : <<use>>

class StationsView {
    - openFilterDialog()
    - showMessage(message : String)
    ' HU 532314 - Buscar estación por nombre
    - stationSearchView : SearchView
    - suggestionsAdapter : SimpleCursorAdapter
    - suggestedStations : List<Station>
    + onCreateOptionsMenu(menu : Menu) : boolean
    - selectSuggestion(position : int) : boolean
    + showSearchSuggestions(stations : List<Station>)
    + showStationNotFound()
    + showSuggestion(station : Station)
    + showStationLocation(station : Station)
}

class StationsArrayAdapter

class StationsPresenter {
    ~ {static} MIN_FILTER_VALUE : int = 1
    ~ {static} MIN_EMPTY_SLOTS_FILTER_VALUE : int = 0
    - network : Network
    - location : String
    - stations : List<Station>
    - loadFailed : boolean
    - minFreeBikes : Integer
    - minEmptySlots : Integer
    - maxDistKm : Double
    - userLocation : double[]
    - load(networkId : String)
    - showAllStations()
    - showStationList(list : List<Station>)
    - showFilteredStations(list : List<Station>)
    - applyFilters() : List<Station>
    - activeFiltersCount() : int
    - distancesTo(list : List<Station>) : Map<Station, Double>
    - sortByDistance(list : List<Station>, distances : Map<Station, Double>) : List<Station>
    - parseMinFreeBikes(text : String) : Integer
    - parseMinEmptySlots(text : String) : Integer
    - parseMaxDistance(text : String) : Double
    - parseMinimum(text : String, lowerLimit : int) : Integer
    - formatLocation(location : Location) : String
    ' HU 532314 - Buscar estación por nombre
    + onSearchTextChanged(text : String)
    + onStationSelected(station : Station)
}

class StationFilter {
    + {static} filterByMinFreeBikes(stations : List<Station>, minFreeBikes : int) : List<Station>
    + {static} hasValidFreeBikes(station : Station) : boolean
    + {static} filterByMinEmptySlots(stations : List<Station>, minEmptySlots : int) : List<Station>
    + {static} hasValidEmptySlots(station : Station) : boolean
    + {static} filterByMaxDistance(stations : List<Station>, lat : double, lon : double, maxDistKm : double) : List<Station>
    + {static} hasValidCoordinates(station : Station) : boolean
    + {static} distanceKm(lat1 : double, lon1 : double, lat2 : double, lon2 : double) : double
}

class StationUtils {
    + {static} sortByFreeBikes(stations : List<Station>) : List<Station>
    + {static} sortByEmptySlots(stations : List<Station>) : List<Station>
    + {static} formatValue(value : Integer) : String
    + {static} formatText(text : String) : String
    + {static} formatBikes(freeBikes : Integer, emptySlots : Integer, slots : Integer) : String
    + {static} formatDistance(distanceKm : Double) : String
    + {static} hasEbikes(station : Station) : boolean
}

class StationSearch {
    + {static} MAX_CHANGES : int = 2
    + {static} searchByName(stations : List<Station>, text : String) : List<Station>
    + {static} findMostSimilar(stations : List<Station>, text : String) : Station
}

interface IStationsContract.Presenter {
    + init(view : View, network : Network)
    + onFilterApplied(minFreeBikesText : String)
    + onMinEmptySlotsFilterApplied(minEmptySlotsText : String)
    + onDistanceFilterApplied(maxDistKmText : String)
    + getMaxCityDistanceKm() : double
    + onFilterCleared()
    + onInfoClicked()
    + onSearchTextChanged(text : String)
    + onStationSelected(station : Station)
}

interface IStationsContract.View {
    + getNetworksRepository() : INetworksRepository
    + showNetworkName(name : String)
    + showNetworkLocation(location : String)
    + showStations(stations : List<Station>)
    + showNoStations()
    + showLoadError()
    + showNoStationsWithMinFreeBikes(minFreeBikes : int)
    + showInvalidMinFreeBikes()
    + showNoStationsWithMinEmptySlots(minEmptySlots : int)
    + showInvalidMinEmptySlots()
    + showEmptySlotsFilterError()
    + showActiveFiltersCount(numActiveFilters : int)
    + showMinEmptySlotsFilterActive(minEmptySlots : int)
    + mostrarErrorQuitarFiltros()
    + showFilterActive(minFreeBikes : int)
    + showFilterInactive()
    + showNetworkDetails(network : Network)
    + showSearchSuggestions(stations : List<Station>)
    + showStationNotFound()
    + showSuggestion(station : Station)
    + showStationLocation(station : Station)
    + getUserLocation() : double[]
    + showNoStationsWithinDistance(maxDistKm : double)
    + showLocationUnavailableForFilter()
    + showInvalidMaxDistance()
    + showDistanceFilterActive(maxDistKm : double)
    + showStationsWithDistance(stations : List<Station>, distances : Map<Station, Double>)
}

interface StationsCallback {
    + onSuccess(stations : List<Station>)
    + onFailure(e : Throwable)
}

@enduml
