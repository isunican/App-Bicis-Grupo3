
@startuml architecture

hide empty members

' ==========================================
' Arquitectura existente - Redes de bicicletas
' ==========================================

MainView ..|> IMainContract.View
MainPresenter ..|> IMainContract.Presenter
MainView --> INetworksRepository : repository
ApiNetworksRepository ..|> INetworksRepository
JsonNetworksRepository ..|> INetworksRepository
MainView --> MainPresenter : presenter
MainPresenter --> MainView : view
MainView ..> InfoView : <<use>>
MainView ..> DetailsView : <<use>>

class MainView {
}

class MainPresenter {
    -load()
}

class InfoView
class DetailsView
class ApiNetworksRepository
class JsonNetworksRepository

interface IMainContract.View {
    + init()
    + getNetworksRepository() : INetworksRepository
    + showNetworks(networks : List<Network>)
    + showLoadCorrect(networks : int)
    + showLoadError()
    + showNetworkDetails(network : Network)
    + showInfoActivity()
}

interface IMainContract.Presenter {
    + init(View view)
    + onNetworkClicked(network : Network)
    + onMenuInfoClicked()
}

interface INetworksRepository {
    + requestNetworks(cb : NetworksCallback )
    + requestNetwork(cb: NetworkDetailsCallback , networkId : String)
}

interface NetworksCallback {
    + onSuccess(networks : List<Network>)
    + onFailure(e : Throwable)
}

interface NetworkDetailsCallback {
    + onSuccess(network : Networ)
    + onFailure(e : Throwable)
}


' ==========================================
' HU 532317 - Quitar los filtros aplicados
' ==========================================

interface "IStationsContract.Presenter" as IStationsPresenter {
    + init(view : View, stations : List<Station>)
    + onFilterApplied(minFreeBikesText : String)
    + onFilterCleared()
}

interface "IStationsContract.View" as IStationsView {
    + showStations(stations : List<Station>)
    + showNoStationsWithMinFreeBikes(minFreeBikes : int)
    + showInvalidMinFreeBikes()
    + mostrarErrorQuitarFiltros()
}

class StationsPresenter {
    - view : IStationsContract.View
    - stations : List<Station>
    {static} ~ MIN_FILTER_VALUE : int
    + init(view : View, stations : List<Station>)
    + onFilterApplied(minFreeBikesText : String)
    + onFilterCleared()
    - parseMinFreeBikes(text : String) : Integer
}

class Station
class StationFilter {
    {static} + filterByMinFreeBikes(stations : List<Station>, minFreeBikes : int) : List<Station>
}

StationsPresenter ..|> IStationsPresenter
StationsPresenter --> IStationsView : view
StationsPresenter --> StationFilter : <<use>>
StationsPresenter --> Station : stations
IStationsView ..> Station : <<use>>

@enduml
