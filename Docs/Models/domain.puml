
@startuml domain
hide empty members

' ==========================================
' Dominio principal - Redes
' ==========================================

class Network {
    - id : String
    - name : String
    - href : String
    - company : String[]
    - gbfsHref : String
    - ebikes : Boolean
    + countOperators() : Integer
    + hasOnlyBasicInfo() : boolean
}

class Location {
    - city : String
    - country : String
    - latitude : Double
    - longitude : Double
    + hasValidCoordinates() : boolean
}

class NetworksResponse {
    + getNetworksCount() : int
}
class NetworkResponse

Network *--> "1" Location : location
NetworksResponse *--> "*" Network : networks
NetworkResponse *--> "1" Network : network

' ==========================================
' Estaciones (HU 532377 Listar estaciones)
' Las clases de utilidad (StationFilter, StationSearch, NetworkLocator,
' CitySelector) no son del dominio: estan en el diagrama de arquitectura.
' ==========================================

class Station {
    - id : String
    - name : String
    - latitude : Double
    - longitude : Double
    - timestamp : String
    - freeBikes : Integer
    - emptySlots : Integer
    + getEbikes() : Integer
    + getSlots() : Integer
}

class StationExtra {
    - ebikes : Integer
    - slots : Integer
}

Network *--> "*" Station : stations
Station *--> "0..1" StationExtra : extra

@enduml
