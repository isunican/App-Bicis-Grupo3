<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del diálogo de filtros de la pantalla de estaciones (StationsView).
     Cada filtro es un campo independiente; un campo vacío significa que ese filtro no se aplica.
     El filtro por distancia solo se aplica si su interruptor está activado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <!-- Filtro por bicis libres (HU 532376) -->
    <TextView
        android:id="@+id/tvMinFreeBikesLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/etMinFreeBikes"
        android:text="@string/filterHint"
        android:textSize="12sp" />

    <EditText
        android:id="@id/etMinFreeBikes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="@string/filterHint"
        android:inputType="number" />

    <!-- Filtro por huecos libres (HU 532335) -->
    <TextView
        android:id="@+id/tvMinEmptySlotsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:labelFor="@id/etMinEmptySlots"
        android:text="@string/filterEmptySlotsHint"
        android:textSize="12sp" />

    <EditText
        android:id="@id/etMinEmptySlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="@string/filterEmptySlotsHint"
        android:inputType="number" />

    <!-- Filtro por tipo de bicicleta (HU 532305) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filterBikeTypeLabel"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cbElectricBike"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/filterBikeTypeElectric" />

    <CheckBox
        android:id="@+id/cbMechanicalBike"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/filterBikeTypeMechanical" />

    <!-- Filtro por distancia (HU 532304): interruptor, barra y campo en km sincronizados -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swDistanceFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filterDistanceSwitch" />

    <TextView
        android:id="@+id/tvMaxDistanceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/etMaxDistance"
        android:text="@string/filterDistanceLabel"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@id/sbMaxDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <EditText
            android:id="@id/etMaxDistance"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:gravity="end"
            android:hint="@string/filterDistanceHint"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:text="@string/filterDistanceUnit" />
    </LinearLayout>

    <!-- Se muestra cuando no se conoce la ubicación del usuario -->
    <TextView
        android:id="@id/tvDistanceUnavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filterDistanceUnavailable"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
